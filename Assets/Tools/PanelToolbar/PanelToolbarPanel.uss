/* Panel toolbar — top-centred bar of toggle buttons, one per workstation panel. */

.toolbar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    padding: 6px;
}

.toolbar-buttons {
    flex-direction: row;
    background-color: rgba(28, 28, 32, 0.92);
    border-radius: 6px;
    padding: 4px;
    border-width: 1px;
    border-color: #333;
}

.toolbar-button {
    margin-right: 4px;
    padding: 4px 10px;
    background-color: #1F1F24;
    color: #C8C8C8;
    border-width: 1px;
    border-color: #444;
    border-radius: 3px;
}

.toolbar-button:hover {
    background-color: #2D3D55;
}

.toolbar-button.active {
    background-color: #2E7DD7;
    color: white;
    border-color: #2E7DD7;
}
