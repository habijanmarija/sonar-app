/* Screw planner — pick a target vertebra (active segment), drop two world
   points (entry + tip) to lay out a virtual pedicle screw, and read out the
   fraction of the screw's voxels that land inside the target's mask. */

.screw-panel {
    position: absolute;
    top: 50px;
    right: 16px;
    width: 320px;
    padding: 12px;
    max-width: none;
}

.screw-content {
    margin-top: 6px;
    display: none;
}

.screw-content.visible {
    display: flex;
}

.screw-target {
    -unity-font-style: bold;
    color: #DDDDDD;
    margin-bottom: 4px;
}

.screw-status {
    margin-bottom: 8px;
    color: #B5B5B5;
}

.screw-actions {
    flex-direction: row;
    margin-bottom: 8px;
}

.screw-actions > Button {
    flex-grow: 1;
    margin-right: 4px;
}

.screw-count {
    margin-bottom: 6px;
    color: #C5C5C5;
}

.screws-scroll {
    max-height: 140px;
    margin-bottom: 6px;
}

.screw-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
    padding: 2px 4px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.04);
}

.screw-row-swatch {
    width: 12px;
    height: 12px;
    margin-right: 6px;
    border-radius: 2px;
    border-width: 1px;
    border-color: #555;
}

.screw-row-name {
    flex-grow: 1;
    color: #C8C8C8;
    font-size: 11px;
}

.screw-row-grade {
    width: 22px;
    margin-right: 4px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 10px;
    border-radius: 2px;
    padding: 1px 3px;
    color: #FFFFFF;
}
.screw-row-grade.green  { background-color: #2E8B3F; }
.screw-row-grade.yellow { background-color: #DAA62F; color: #1F1F1F; }
.screw-row-grade.red    { background-color: #B73B30; }

.screw-row-delete {
    width: 22px;
    height: 18px;
    background-color: #3A1F22;
    color: #FFBBAA;
    border-width: 1px;
    border-color: #5A2C30;
    border-radius: 2px;
    -unity-text-align: middle-center;
}

.screw-readout {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.screw-readout-label {
    flex-grow: 1;
    color: #C8C8C8;
}

.screw-coverage {
    font-size: 22px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.screw-gate {
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    padding: 4px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.06);
}

.screw-gate.green  { color: #FFFFFF; background-color: #2E8B3F; }
.screw-gate.yellow { color: #1F1F1F; background-color: #DAA62F; }
.screw-gate.red    { color: #FFFFFF; background-color: #B73B30; }

.screw-trajectory {
    margin-top: 6px;
    color: #C8C8C8;
    -unity-font-style: italic;
}

.screw-breach {
    margin-top: 4px;
    color: #E0A070;
    white-space: normal;
}

.screw-canal-grade {
    margin-top: 6px;
    padding: 4px 6px;
    border-radius: 3px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    background-color: rgba(255, 255, 255, 0.05);
    white-space: normal;
    font-size: 11px;
}

.screw-canal-grade.grade-a { color: #FFFFFF; background-color: #2E8B3F; }
.screw-canal-grade.grade-b { color: #1F1F1F; background-color: #DAA62F; }
.screw-canal-grade.grade-c { color: #FFFFFF; background-color: #C66A2F; }
.screw-canal-grade.grade-d { color: #FFFFFF; background-color: #B73B30; }

.screw-sonar-metrics {
    margin-top: 8px;
    padding: 4px 6px;
    color: #DDDDDD;
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 3px;
    white-space: normal;
}
