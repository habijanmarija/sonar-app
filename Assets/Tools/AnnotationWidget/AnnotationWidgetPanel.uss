/* Annotations — left column, bottom row. */

.annotation-panel {
    position: absolute;
    bottom: 16px;
    left: 16px;
    width: 300px;
    padding: 14px;
}

.annotation-panel .title {
    font-size: 15px;
}

.add-row {
    flex-direction: row;
    margin-top: 6px;
    margin-bottom: 6px;
    align-items: center;
}

.add-row-label {
    flex-grow: 1;
    margin-right: 6px;
}

.add-row-button {
    padding: 4px 8px;
    margin-left: 0;
}

.annotations-scroll {
    max-height: 140px;
    margin-top: 4px;
}

.annotation-row {
    flex-direction: row;
    align-items: center;
    background-color: #1F1F24;
    border-radius: 4px;
    padding: 5px 8px;
    margin-bottom: 4px;
    border-width: 1px;
    border-color: #333;
}

.annotation-row-label {
    flex-grow: 1;
    color: #E8E8E8;
}

.annotation-row-delete {
    padding: 2px 8px;
    margin-left: 6px;
    background-color: #5A2222;
    color: white;
    border-radius: 3px;
}

.annotation-row-delete:hover {
    background-color: #7A2828;
}
