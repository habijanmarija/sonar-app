<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="project://database/Assets/Core/UI/Shared/HostStyles.uss" />
  <Style src="project://database/Assets/Tools/PatientBriefing/PatientBriefingPanel.uss" />
  <ui:VisualElement name="root" class="panel briefing-panel">
    <ui:Label text="Patient briefing" class="title" />
    <ui:Label name="empty-message" text="No patient loaded." class="hint" />

    <ui:VisualElement name="content" class="briefing-content">
      <ui:VisualElement class="briefing-row">
        <ui:Label text="ID" class="briefing-key" />
        <ui:Label name="patient-id" class="briefing-value" />
      </ui:VisualElement>
      <ui:VisualElement class="briefing-row">
        <ui:Label text="Pseudonym" class="briefing-key" />
        <ui:Label name="pseudonym" class="briefing-value" />
      </ui:VisualElement>
      <ui:VisualElement class="briefing-row">
        <ui:Label text="Age band" class="briefing-key" />
        <ui:Label name="age-band" class="briefing-value" />
      </ui:VisualElement>
      <ui:VisualElement class="briefing-row">
        <ui:Label text="Sex" class="briefing-key" />
        <ui:Label name="sex" class="briefing-value" />
      </ui:VisualElement>
      <ui:VisualElement class="briefing-row">
        <ui:Label text="Captured" class="briefing-key" />
        <ui:Label name="captured" class="briefing-value" />
      </ui:VisualElement>
      <ui:VisualElement class="briefing-row">
        <ui:Label text="Indication" class="briefing-key" />
        <ui:Label name="indication" class="briefing-value" />
      </ui:VisualElement>
      <ui:VisualElement class="briefing-row">
        <ui:Label text="History" class="briefing-key" />
        <ui:Label name="history" class="briefing-value briefing-multiline" />
      </ui:VisualElement>
      <ui:VisualElement class="briefing-row">
        <ui:Label text="Data" class="briefing-key" />
        <ui:Label name="data-summary" class="briefing-value" />
      </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement class="actions">
      <ui:Button name="back-to-patients" text="← Patients" class="btn-secondary" />
      <ui:Button name="close" text="Close" class="btn-secondary" />
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
