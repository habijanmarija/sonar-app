<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="project://database/Assets/Core/UI/Shared/HostStyles.uss" />
  <Style src="project://database/Assets/Tools/OpacityControl/OpacityControlPanel.uss" />
  <ui:VisualElement name="root" class="panel opacity-panel">
    <ui:Label text="Opacity" class="title" />
    <ui:Label name="empty-message" text="No patient loaded." class="hint" />

    <ui:VisualElement name="sliders" class="sliders-list" />

    <ui:VisualElement class="actions">
      <ui:Button name="close" text="Close" class="btn-secondary" />
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
