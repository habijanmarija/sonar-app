/* Volume controls — right column, middle row. */

.volume-panel {
    position: absolute;
    top: 320px;
    right: 16px;
    width: 320px;
    padding: 12px;
}

.volume-panel .title {
    font-size: 15px;
}

.volume-content {
    margin-top: 6px;
    display: none;
}

.volume-content.visible {
    display: flex;
}

.control-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.control-label {
    width: 95px;
    color: #BFBFBF;
}

.control-slider {
    flex-grow: 1;
    margin: 0 6px;
}

.control-value {
    width: 44px;
    color: #B0B0B0;
    -unity-text-align: middle-right;
}

.presets {
    margin-top: 8px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: #2A2A2E;
}

.presets-label {
    -unity-font-style: bold;
    color: #BFBFBF;
    margin-bottom: 4px;
}

.preset-row {
    flex-direction: row;
    margin-top: 6px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: #2A2A2E;
}

.preset-btn {
    padding: 3px 8px;
    margin-right: 4px;
    background-color: #1F1F24;
    color: #E8E8E8;
    border-width: 1px;
    border-color: #444;
    border-radius: 3px;
}

.preset-btn:hover {
    background-color: #2D3D55;
}
