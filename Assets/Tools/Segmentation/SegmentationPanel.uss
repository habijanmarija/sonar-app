/* Segmentation panel — sits between Slice viewer and Volume on the right column,
   or wherever the layout allows. */

.segmentation-panel {
    position: absolute;
    top: 50px;
    left: 16px;
    width: 300px;
    padding: 12px;
}

.segmentation-panel .title {
    font-size: 15px;
}

.segmentation-content {
    margin-top: 6px;
    display: none;
}

.segmentation-content.visible {
    display: flex;
}

.enable-toggle {
    margin-bottom: 6px;
}

.control-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.control-label {
    width: 55px;
    color: #BFBFBF;
}

.control-slider {
    flex-grow: 1;
    margin: 0 6px;
}

.control-value {
    width: 44px;
    color: #B0B0B0;
    -unity-text-align: middle-right;
}

.color-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.color-swatch {
    width: 28px;
    height: 22px;
    margin-left: 4px;
    border-width: 1px;
    border-color: #444;
    border-radius: 3px;
}

.color-swatch.red    { background-color: #FF6B4A; }
.color-swatch.green  { background-color: #5BD17A; }
.color-swatch.yellow { background-color: #F4D03F; }
.color-swatch.blue   { background-color: #4A9DFF; }

.subtitle {
    color: #DDDDDD;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.segments-section {
    margin-bottom: 8px;
}

.segments-list {
    flex-direction: column;
    margin-bottom: 4px;
    max-height: 200px;
    overflow: hidden;
}

.segment-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
    padding: 4px 6px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.04);
    min-height: 24px;
}

.segment-row.active {
    background-color: rgba(74, 157, 255, 0.18);
    border-width: 1px;
    border-color: #4A9DFF;
}

.segment-row-color {
    width: 14px;
    height: 14px;
    margin-right: 6px;
    border-radius: 2px;
    border-width: 1px;
    border-color: #555;
}

.segment-row-name {
    flex-grow: 1;
    color: #C8C8C8;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 2px 4px;
}

.segment-row-eye {
    width: 22px;
    height: 18px;
    margin-left: 4px;
    background-color: rgba(255, 220, 0, 0.18);
    color: #F5D34E;
    border-width: 1px;
    border-color: #6A5210;
    border-radius: 2px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.segment-row-eye-off {
    background-color: rgba(160, 160, 160, 0.10);
    color: #6E6E6E;
    border-color: #3A3A3A;
}

/* Dim the whole row when its segment is hidden so the panel matches the 3D view. */
.segment-row.hidden-segment {
    opacity: 0.55;
}

.segment-row-delete {
    width: 22px;
    height: 18px;
    margin-left: 4px;
    background-color: #3A1F22;
    color: #FFBBAA;
    border-width: 1px;
    border-color: #5A2C30;
    border-radius: 2px;
    -unity-text-align: middle-center;
}

.segment-add-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.new-segment-name {
    flex-grow: 1;
    margin-right: 4px;
}

.active-segment-label {
    margin-top: 2px;
    color: #B0B0B0;
}
